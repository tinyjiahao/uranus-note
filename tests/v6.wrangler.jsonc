{
  "name": "uranus-v6-verification",
  "main": "../worker/index.ts",
  "compatibility_date": "2026-10-23",
  "assets": { "directory": "../dist/client", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "uranus-v6-verification", "database_id": "00000000-0000-4000-8000-000000000006", "migrations_dir": "../migrations/d1", "migrations_table": "uranus_d1_migrations" }],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "uranus-v6-verification" }],
  "ratelimits": [{ "name": "LOGIN_RATE_LIMITER", "namespace_id": "1006", "simple": { "limit": 10, "period": 60 } }],
  "vars": { "APP_ENV": "development", "REGISTRATION_ENABLED": "true", "SESSION_SECRET": "isolated-test-only-not-for-deployment-session-secret" }
}
